---
// Icon links for every entry in site.links, used in the hero and the footer.
import { site } from '../data/site';

interface Props {
  size?: 'large' | 'small';
}

const { size = 'large' } = Astro.props;

const icons: Record<string, { viewBox: string; svg: string }> = {
  GitHub: {
