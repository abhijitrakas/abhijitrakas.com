  },
  LinkedIn: {
    viewBox: '3 3 18 18',
    svg: '<path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zm1.78 13.02H3.56V9h3.56v11.45z"/>',
  },
  WordPress: {
    viewBox: '0 0 24 24',
    svg: '<path fill="currentColor" d="M21.469 6.825c.84 1.537 1.318 3.3 1.318 5.175 0 3.979-2.156 7.456-5.363 9.325l3.295-9.527c.615-1.54.82-2.771.82-3.864 0-.405-.026-.78-.07-1.11m-7.981.105c.647-.03 1.232-.105 1.232-.105.582-.075.514-.93-.067-.899 0 0-1.755.135-2.88.135-1.064 0-2.85-.15-2.85-.15-.585-.03-.661.855-.075.885 0 0 .54.061 1.125.09l1.68 4.605-2.37 7.08L5.354 6.9c.649-.03 1.234-.1 1.234-.1.585-.075.516-.93-.065-.896 0 0-1.746.138-2.874.138-.2 0-.438-.008-.69-.015C4.911 3.15 8.235 1.215 12 1.215c2.809 0 5.365 1.072 7.286 2.833-.046-.003-.091-.009-.141-.009-1.06 0-1.812.923-1.812 1.914 0 .89.513 1.643 1.06 2.531.411.72.89 1.643.89 2.977 0 .915-.354 1.994-.821 3.479l-1.075 3.585-3.9-11.61.001.014zM12 22.784c-1.059 0-2.081-.153-3.048-.437l3.237-9.406 3.315 9.087c.024.053.05.101.078.149-1.12.393-2.325.609-3.582.609M1.211 12c0-1.564.336-3.05.935-4.39L7.29 21.709C3.694 19.96 1.212 16.271 1.211 12M12 0C5.385 0 0 5.385 0 12s5.385 12 12 12 12-5.385 12-12S18.615 0 12 0"/>',
  },
  Email: {
    viewBox: '0 0 24 24',
    svg: '<g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="1.5"/><path d="m3 6 9 7 9-7"/></g>',
  },
};
---

<ul class:list={['social', size]}>
  {
    site.links.map((link) => (
      <li>
        <a
          href={link.href}
          rel={link.href.startsWith('http') ? 'me' : undefined}
          aria-label={link.label}
          title={link.label === 'Email' ? link.handle : link.label}
        >
          <svg viewBox={icons[link.label].viewBox} aria-hidden="true" set:html={icons[link.label].svg} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social li {
    display: flex;
  }

  .social li:first-child {
    padding-left: 0;
  }

  .social li + li {
    border-left: 1px solid var(--line);
  }

  .social a {
    display: block;
    color: var(--fg);
    transition: color 150ms, transform 150ms;
  }

  .social a:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  .social svg {
    display: block;
  }

  .large li {
    padding: 0.125rem clamp(1.25rem, 2.4vw, 2rem);
  }

  .large svg {
    width: 2.125rem;
    height: 2.125rem;
  }

  .small li {
    padding: 0 0.875rem;
  }

  .small li:last-child {
    padding-right: 0;
  }

  .small a {
    color: var(--muted);
  }

  .small svg {
    width: 1.125rem;
    height: 1.125rem;
  }
</style>
