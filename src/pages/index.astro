---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/portrait.webp';
import RichText from '../components/RichText.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
---

<Base>
  <section class="hero">
    <div class="intro">
      <h1 class="reveal" style="--i: 1">I’m {site.name}<span class="dot">.</span></h1>

      <p class="bio reveal" style="--i: 2"><RichText text={site.bio} /></p>

      <div class="links reveal" style="--i: 3">
        <SocialLinks />
      </div>
    </div>

    <figure class="portrait">
      <Image
        class="reveal"
        style="--i: 1"
        src={portrait}
        alt={`Pencil sketch portrait of ${site.name}`}
        widths={[360, 540, 720, 960, 1199]}
        sizes="(max-width: 56rem) 22rem, 44rem"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="more" aria-labelledby="more-title">
    <h2 id="more-title">Beyond work<span class="dot">.</span></h2>
    <ul class="facts">
      {
        site.about.map((item) => (
          <li>
            <h3>{item.label}</h3>
            <p>
              <RichText text={item.text} />
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* Top padding scales with screen height so the hero roughly fills a desktop
     first screen. No bottom padding: the portrait's faded edge is the gap. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: 2rem;
    padding-block: clamp(1.5rem, 6vh, 4rem) 0;
  }

  /* Keep text above the sketch's hatching where they overlap. */
  .intro {
    position: relative;
    z-index: 1;
  }

  h1 {
    font-family: var(--serif);
    font-weight: 700;
    /* Text optical size: sturdier, wider letterforms than the display cut. */
    font-variation-settings: 'opsz' 24;
    font-size: clamp(2.6rem, 1rem + 4.2vw, 5.25rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .dot {
    color: var(--accent);
  }

  .bio {
    max-width: 26em;
    margin-top: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--muted);
    font-size: clamp(1.0625rem, 0.8rem + 0.85vw, 1.5rem);
    line-height: 1.65;
  }

  /* Links come from RichText, a child component, so they need :global. */
  .bio :global(a),
  .facts :global(a) {
    color: var(--fg);
    text-decoration-line: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 150ms;
  }

  .bio :global(a:hover),
  .facts :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .links {
    margin-top: clamp(2.5rem, 4.5vw, 3.75rem);
  }

  /* The sketch's soft edges may drift into the text column, like the mockup. */
  .portrait {
    justify-self: end;
    width: calc(100% + 6rem);
    max-width: 44rem;
    margin-left: -6rem;
  }

  /* Multiply lets the white paper of the sketch disappear into the page.
     (The bottom fade is baked into the image, so no CSS mask is needed.) */
  .portrait :global(img) {
    display: block;
    width: min(100%, calc((100svh - 12rem) * 0.914));
    height: auto;
    margin-left: auto;
    mix-blend-mode: multiply;
  }

  .more {
    padding-block: clamp(3.5rem, 4vw, 4rem) clamp(3.5rem, 7vw, 6rem);
  }

  h2 {
    margin: 0 0 clamp(1.75rem, 3vw, 2.75rem);
    font-family: var(--serif);
    font-weight: 700;
    font-variation-settings: 'opsz' 24;
    font-size: clamp(1.875rem, 1.2rem + 1.8vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.75rem, 3.5vw, 3.5rem);
    padding: 0;
    list-style: none;
  }

  /* A short orange rule above each label echoes the headline's dot. */
  h3 {
    margin: 0 0 0.625rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3::before {
    content: '';
    display: block;
    width: 1.5rem;
    height: 2px;
    margin-bottom: 0.875rem;
    background: var(--accent);
  }

  .facts p {
    max-width: 26em;
    color: var(--muted);
    font-size: clamp(1rem, 0.92rem + 0.3vw, 1.125rem);
    line-height: 1.65;
  }

  @media (max-width: 56rem) {
    .facts {
      grid-template-columns: 1fr;
    }

    .hero {
      grid-template-columns: 1fr;
      align-items: start;
      /* Extra height goes below the content, not between portrait and name. */
      align-content: start;
      gap: 0.5rem;
      padding-block: 1rem 0;
    }

    /* The sketch's bottom ~12% is its soft fade, so tuck the name up into it. */
    .portrait {
      order: -1;
      justify-self: center;
      width: 100%;
      max-width: 22rem;
      margin-left: 0;
      margin-bottom: -1.25rem;
    }

    .portrait :global(img) {
      width: 100%;
      margin-inline: auto;
    }
  }
</style>
