---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base>
  <header class="reveal" style="--i: 0">
    <!-- Placeholder until the photo arrives: swap for an <Image> from astro:assets. -->
    <div class="avatar" aria-hidden="true">AR</div>
    <h1>{site.name}</h1>
    <p class="bio">
      Software engineer at <a href={site.company.url}>{site.company.name}</a>. I build for the web
      with WordPress, PHP and JavaScript, and enjoy making small tools that make developers’ lives
      easier.
    </p>
  </header>

  <section class="reveal" style="--i: 1" aria-labelledby="connect">
    <h2 id="connect">Connect</h2>
    <ul class="links">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href} rel={link.href.startsWith('http') ? 'me' : undefined}>
              <span class="label">{link.label}</span>
              <span class="handle">{link.handle}</span>
              <svg class="arrow" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  header {
    margin-bottom: 3.5rem;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.5rem;
    border-radius: 999px;
    background: var(--hover);
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    user-select: none;
  }

  h1 {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .bio {
    margin-top: 0.25rem;
    color: var(--muted);
  }

  .bio a {
    color: var(--fg);
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, var(--muted) 50%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms;
  }

  .bio a:hover {
    text-decoration-color: currentColor;
  }

  h2 {
    margin-bottom: 0.75rem;
    color: var(--muted);
    font-size: inherit;
    font-weight: 400;
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 0 -0.625rem;
  }

  .links a {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 150ms;
  }

  .links a:hover {
    background: var(--hover);
  }

  .handle {
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arrow {
    color: var(--muted);
    transition: transform 150ms, color 150ms;
  }

  .links a:hover .arrow {
    color: var(--fg);
    transform: translate(1px, -1px);
  }

  @media (max-width: 420px) {
    .links a {
      grid-template-columns: 5rem 1fr auto;
    }
  }
</style>
