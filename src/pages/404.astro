---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`Page not found · ${site.name}`} description="This page doesn’t exist." noindex>
  <section class="notfound">
    <p class="code reveal" style="--i: 1">404</p>
    <h1 class="reveal" style="--i: 2">This page went for a bike tour<span class="dot">.</span></h1>
    <p class="note reveal" style="--i: 3">
      The link may be broken, or the page may have moved. Everything about me is on the home page.
    </p>
    <a class="home reveal" style="--i: 4" href="/">
      Back to home
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>
</Base>

<style>
  .notfound {
    max-width: 40rem;
    padding-block: clamp(4rem, 14vh, 9rem);
  }

  .code {
    margin-bottom: 1rem;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  h1 {
    font-family: var(--serif);
    font-weight: 700;
    font-variation-settings: 'opsz' 24;
    font-size: clamp(2.25rem, 1.2rem + 3vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .dot {
    color: var(--accent);
  }

  .note {
    max-width: 30em;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: clamp(1.0625rem, 0.9rem + 0.5vw, 1.25rem);
    line-height: 1.65;
  }

  .home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    color: var(--fg);
    font-weight: 600;
    text-decoration: none;
  }

  .home svg {
    transition: transform 150ms;
  }

  .home:hover {
    color: var(--accent);
  }

  .home:hover svg {
    transform: translateX(3px);
  }
</style>
